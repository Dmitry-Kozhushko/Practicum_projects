-- Расчёт MAU авторов
SELECT 
    a.main_author_name,
    COUNT(DISTINCT au.puid) AS mau
FROM bookmate.audition au
INNER JOIN bookmate.content c 
    ON au.main_content_id = c.main_content_id
INNER JOIN bookmate.author a 
    ON c.main_author_id = a.main_author_id
WHERE CAST(au.msk_business_dt_str AS DATE) >= '2024-11-01'
  AND CAST(au.msk_business_dt_str AS DATE) < '2024-12-01'
GROUP BY a.main_author_name
ORDER BY mau DESC
LIMIT 3;

-- Расчёт MAU произведений
SELECT 
    c.main_content_name,
    c.published_topic_title_list,
    a.main_author_name,
    COUNT(DISTINCT au.puid) AS mau
FROM bookmate.audition au
INNER JOIN bookmate.content c 
    ON au.main_content_id = c.main_content_id
INNER JOIN bookmate.author a 
    ON c.main_author_id = a.main_author_id
WHERE au.msk_business_dt_str >= '2024-11-01'
  AND au.msk_business_dt_str < '2024-12-01'
GROUP BY 
    c.main_content_name,
    c.published_topic_title_list,
    a.main_author_name
ORDER BY mau DESC
LIMIT 3;

-- Расчёт Retention Rate
WITH cohort_users AS (
    SELECT DISTINCT puid
    FROM bookmate.audition
    WHERE CAST(msk_business_dt_str AS DATE) = '2024-12-02'
),

daily_activity AS (
    SELECT 
        CAST(au.msk_business_dt_str AS DATE) AS activity_date,
        COUNT(DISTINCT au.puid) AS retained_users
    FROM bookmate.audition au
    WHERE CAST(au.msk_business_dt_str AS DATE) >= '2024-12-02'
      AND CAST(au.msk_business_dt_str AS DATE) <= '2024-12-11'
      AND au.puid IN (SELECT puid FROM cohort_users)
    GROUP BY CAST(au.msk_business_dt_str AS DATE)
)

SELECT 
    (activity_date - DATE '2024-12-02') AS day_since_install,
    retained_users,
    ROUND(retained_users * 1.0 / MAX(retained_users) OVER (), 2) AS retention_rate
FROM daily_activity
ORDER BY day_since_install ASC;  

-- Расчёт LTV
WITH user_monthly_revenue AS (
    -- для каждого пользователя определяем уникальные месяцы активности
    SELECT 
        au.puid,
        g.usage_geo_id_name AS city,
        DATE_TRUNC('month', CAST(au.msk_business_dt_str AS DATE)) AS activity_month,
        399 AS monthly_revenue
    FROM bookmate.audition au
    INNER JOIN bookmate.geo g 
        ON au.usage_geo_id = g.usage_geo_id
    WHERE g.usage_geo_id_name IN ('Москва', 'Санкт-Петербург')
      AND CAST(au.msk_business_dt_str AS DATE) >= '2024-09-01'
      AND CAST(au.msk_business_dt_str AS DATE) <= '2024-12-11'
    GROUP BY 
        au.puid,
        g.usage_geo_id_name,
        DATE_TRUNC('month', CAST(au.msk_business_dt_str AS DATE))
),

user_ltv AS (
    -- суммируем доход по каждому пользователю
    SELECT 
        city,
        puid,
        SUM(monthly_revenue) AS user_total_revenue
    FROM user_monthly_revenue
    GROUP BY city, puid
),

city_stats AS (
    -- считаем общий доход и количество пользователей по городам
    SELECT 
        city,
        COUNT(DISTINCT puid) AS total_users,
        SUM(user_total_revenue) AS total_revenue
    FROM user_ltv
    GROUP BY city
)

-- расчёт LTV
SELECT 
    city,
    total_users,
    ROUND(total_revenue * 1.0 / total_users, 2) AS ltv
FROM city_stats
ORDER BY ltv DESC;

-- Расчёт средней выручки прослушанного часа — аналог среднего чека
WITH monthly_stats AS (
    SELECT 
        DATE_TRUNC('month', CAST(msk_business_dt_str AS DATE)) AS month,
        COUNT(DISTINCT puid) AS mau,
        SUM(hours) AS total_hours
    FROM bookmate.audition
    WHERE msk_business_dt_str >= '2024-09-01'
      AND msk_business_dt_str < '2024-12-01'
    GROUP BY 1
)

SELECT 
    month::DATE AS month,
    mau,
    ROUND(total_hours::numeric, 2) AS hours,
    ROUND((mau * 399.0) / NULLIF(total_hours, 0), 2) AS avg_hour_rev
FROM monthly_stats
ORDER BY month;








